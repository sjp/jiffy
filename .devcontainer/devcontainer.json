{
  "name": "Jiffy - Browser extension",
  "image": "mcr.microsoft.com/devcontainers/base:trixie",
  "features": {
    "ghcr.io/devcontainers/features/node:": {
      "version": "26"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Test page server (optional)" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode", "mozilla.firefox-devtools-vscode-firefox-debug"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
        "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
        "files.eol": "\n"
      }
    }
  },

  "mounts": ["source=claude-code-config,target=/home/vscode/.claude,type=volume"],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "remoteUser": "vscode"
}
