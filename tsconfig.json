{
  "compilerOptions": {
    /* Output target — modern browsers (Firefox MV3 / recent Chromium). */
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    /* Module system — bundler-driven, no TS emit (esbuild does the emit). */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Preact JSX runtime — must match the esbuild jsx config. */
    "jsx": "react-jsx",
    "jsxImportSource": "preact",

    /* Ambient types: the Firefox WebExtension `browser.*` API, which the Chrome
       build also uses — see manifest.chrome.json's minimum_chrome_version. */
    "types": ["firefox-webext-browser", "node"],

    /* Strictness — enabled from the start; retrofitting later is painful. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true
  },
  /* Not used by `tsc` here — `npm run typecheck` runs the two projects
     separately. It is for oxlint's type-aware rules: `oxlint-tsgolint`
     discovers projects by looking for a `tsconfig.json`, finds only this
     one, and would otherwise lint every test file against an inferred
     default config (no `jsxImportSource`, no ES2023 lib) where half the
     types collapse to `any` and the rules quietly stop finding anything.
     Following the reference gets them their real config. */
  "references": [{ "path": "./tsconfig.test.json" }],
  "include": ["src", "types"],
  /* Test files + test helpers run under the esbuild test runner (Node globals,
     jsdom, no @types); keep them out of the browser-targeted typecheck. */
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "src/test/**"]
}
