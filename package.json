{
  "name": "jiffy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Firefox extension that gives animated GIFs video-like playback controls (play, pause, frame-step, seek).",
  "scripts": {
    "build": "node scripts/build.mjs --firefox && node scripts/build.mjs --chrome",
    "build:firefox": "node scripts/build.mjs --firefox",
    "build:chrome": "node scripts/build.mjs --chrome",
    "dev:firefox": "node scripts/build.mjs --firefox --watch",
    "dev:chrome": "node scripts/build.mjs --chrome --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3"
  }
}
