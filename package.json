{
  "name": "jiffy",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Browser extension (Firefox & Chrome) that gives animated GIFs, WebP, APNG & AVIF video-like playback controls (play, pause, frame-step, seek).",
  "scripts": {
    "build": "node scripts/build.mjs --firefox && node scripts/build.mjs --chrome",
    "build:firefox": "node scripts/build.mjs --firefox",
    "build:chrome": "node scripts/build.mjs --chrome",
    "dev:firefox": "node scripts/build.mjs --firefox --watch",
    "dev:chrome": "node scripts/build.mjs --chrome --watch",
    "typecheck": "tsc --noEmit",
    "lint": "web-ext lint -s dist-firefox/",
    "lint:js": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/test.mjs",
    "pack": "cd dist-firefox && zip -r ../jiffy-firefox.zip . && cd .. && cd dist-chrome && zip -r ../jiffy-chrome.zip ."
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.77.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "web-ext": "^10.6.0"
  }
}
