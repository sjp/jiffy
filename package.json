{
  "name": "jiffy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Firefox extension that gives animated GIFs video-like playback controls (play, pause, frame-step, seek).",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "preact": "^10.29.2"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
